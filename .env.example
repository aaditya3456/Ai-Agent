# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_job_agent

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# AI Provider Configuration
# Primary: Google Gemini Native API (@google/genai)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite

# Alternative: OpenAI (Uncomment if using OpenAI instead)
# AI_PROVIDER=openai
# AI_API_KEY=your_openai_api_key_here
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# File Upload Constraints
MAX_FILE_SIZE_MB=5
